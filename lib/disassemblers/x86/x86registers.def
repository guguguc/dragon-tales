// X-macro: REG(name, byte_offset, bit_width)
// byte_offset is the position in the IGNIL register address space.
// Sub-registers share the base offset of their parent; width selects the slice.

// 64-bit
REG("RAX",  0,   64)
REG("RCX",  8,   64)
REG("RDX",  16,  64)
REG("RBX",  24,  64)
REG("RSP",  32,  64)
REG("RBP",  40,  64)
REG("RSI",  48,  64)
REG("RDI",  56,  64)
REG("R8",   64,  64)
REG("R9",   72,  64)
REG("R10",  80,  64)
REG("R11",  88,  64)
REG("R12",  96,  64)
REG("R13",  104, 64)
REG("R14",  112, 64)
REG("R15",  120, 64)
REG("RIP",  128, 64)

// 32-bit (same base offset as 64-bit parent)
REG("EAX",  0,   32)
REG("ECX",  8,   32)
REG("EDX",  16,  32)
REG("EBX",  24,  32)
REG("ESP",  32,  32)
REG("EBP",  40,  32)
REG("ESI",  48,  32)
REG("EDI",  56,  32)
REG("R8D",  64,  32)
REG("R9D",  72,  32)
REG("R10D", 80,  32)
REG("R11D", 88,  32)
REG("R12D", 96,  32)
REG("R13D", 104, 32)
REG("R14D", 112, 32)
REG("R15D", 120, 32)

// R8-R15 word (16-bit) sub-registers
REG("R8W",  64,  16)
REG("R9W",  72,  16)
REG("R10W", 80,  16)
REG("R11W", 88,  16)
REG("R12W", 96,  16)
REG("R13W", 104, 16)
REG("R14W", 112, 16)
REG("R15W", 120, 16)

// R8-R15 byte (8-bit) sub-registers
REG("R8B",  64,  8)
REG("R9B",  72,  8)
REG("R10B", 80,  8)
REG("R11B", 88,  8)
REG("R12B", 96,  8)
REG("R13B", 104, 8)
REG("R14B", 112, 8)
REG("R15B", 120, 8)

// 16-bit
REG("AX",   0,   16)
REG("CX",   8,   16)
REG("DX",   16,  16)
REG("BX",   24,  16)
REG("SP",   32,  16)
REG("BP",   40,  16)
REG("SI",   48,  16)
REG("DI",   56,  16)

// 8-bit low
REG("AL",   0,   8)
REG("CL",   8,   8)
REG("DL",   16,  8)
REG("BL",   24,  8)
REG("SPL",  32,  8)
REG("BPL",  40,  8)
REG("SIL",  48,  8)
REG("DIL",  56,  8)

// 8-bit high (byte 1 of the 16-bit view: AH = bits [15:8] of AX)
REG("AH",   1,   8)
REG("CH",   9,   8)
REG("DH",   17,  8)
REG("BH",   25,  8)

// Flags - 1-byte slots, 1-bit semantics; offsets start at 136
REG("CF",   136, 8)
REG("PF",   137, 8)
REG("AF",   138, 8)
REG("ZF",   139, 8)
REG("SF",   140, 8)
REG("OF",   141, 8)
REG("DF",   142, 8)

// XMM0-XMM15 low halves. Preserve the existing scalar-SSE register ABI.
// Packed SSE reads/writes these together with the disjoint high-half bank below.
REG("XMM0",  143, 64)
REG("XMM1",  151, 64)
REG("XMM2",  159, 64)
REG("XMM3",  167, 64)
REG("XMM4",  175, 64)
REG("XMM5",  183, 64)
REG("XMM6",  191, 64)
REG("XMM7",  199, 64)
REG("XMM8",  207, 64)
REG("XMM9",  215, 64)
REG("XMM10", 223, 64)
REG("XMM11", 231, 64)
REG("XMM12", 239, 64)
REG("XMM13", 247, 64)
REG("XMM14", 255, 64)
REG("XMM15", 263, 64)

// Long-mode segment bases (not the 16-bit FS/GS selectors).
// Append without shifting the existing GPR/flag/XMM register ABI.
REG("FSBASE", 272, 64)
REG("GSBASE", 280, 64)

// XMM high halves: disjoint from low halves and FSBASE/GSBASE.
REG("XMM0_HI", 288, 64)
REG("XMM1_HI", 296, 64)
REG("XMM2_HI", 304, 64)
REG("XMM3_HI", 312, 64)
REG("XMM4_HI", 320, 64)
REG("XMM5_HI", 328, 64)
REG("XMM6_HI", 336, 64)
REG("XMM7_HI", 344, 64)
REG("XMM8_HI", 352, 64)
REG("XMM9_HI", 360, 64)
REG("XMM10_HI", 368, 64)
REG("XMM11_HI", 376, 64)
REG("XMM12_HI", 384, 64)
REG("XMM13_HI", 392, 64)
REG("XMM14_HI", 400, 64)
REG("XMM15_HI", 408, 64)
